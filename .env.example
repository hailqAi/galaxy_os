POSTGRES_DB=galaxy_os
POSTGRES_USER=galaxy
POSTGRES_PASSWORD=galaxy_local
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://galaxy:galaxy_local@localhost:5432/galaxy_os?schema=public
API_PORT=3001
NODE_ENV=development
ALLOW_DEV_AUTH=false
DEV_AUTH_USER_EMAIL=admin@galaxy.local
# Noninteractive test automation only; pass to one process, never store here.
# ADMIN_TEMP_PASSWORD=
# ADMIN_CONFIRM_EMAIL=admin@galaxy.local
DEV_SEED_PASSWORD=change-this-local-password
SESSION_COOKIE_NAME=galaxy_session
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=60
AVATAR_STORAGE_PATH=.local/avatars
AVATAR_MAX_BYTES=2097152
UPLOAD_MAX_FILE_BYTES=21474836480
UPLOAD_ORGANIZATION_QUOTA_BYTES=107374182400
# Production: set explicitly at or below final-volume headroom.
UPLOAD_GLOBAL_QUOTA_BYTES=1099511627776
# Production: set explicitly. The staging volume must fit at least
# ceil(2 * UPLOAD_GLOBAL_QUOTA_BYTES / 3), including leftovers across restarts.
UPLOAD_STAGING_CAPACITY_BYTES=824633720832
UPLOAD_ACTOR_STAGING_LIMIT=20
UPLOAD_PART_SIZE_BYTES=67108864
LOCAL_UPLOAD_PATH=.local/uploads
FILE_STORAGE_PATH=.local/files
APP_PUBLIC_ORIGIN=http://<WINDOWS_LAN_IP>:3000
# Production: https://os.example.com (must be HTTPS and path-free)
TRUSTED_PUBLIC_HOSTS=
TRUST_PROXY=false
INTERNAL_API_URL=http://127.0.0.1:3001/api/v1
# Comma-separated development hostnames or IPv4 addresses. .env.local may hold current local addresses and is ignored by Git.
DEV_ALLOWED_ORIGINS=localhost,127.0.0.1,<WSL_IP>,<WINDOWS_LAN_IP>,<LOCAL_HOSTNAME>
NEXT_PUBLIC_API_URL=/api/v1
FEATURE_MARKETING=false
PASSWORD_BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=no-reply@galaxy.local
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# E05 inbound MCP. Enable only after the reviewed migrations and HTTPS routing.
FEATURE_GALAXY_MCP=false
# GALAXY_MCP_ENCRYPTION_KEY=
# Generate/persist a private 32-byte key (64 hex characters); never commit it.
# APP_PUBLIC_ORIGIN must be the exact HTTPS issuer origin.
# EDGE_MCP_UPSTREAM=
# Set the existing Edge process to the loopback API origin when MCP is enabled.
# Optional shared private admission marker; deployment script writes drain/closed atomically.
GALAXY_DEPLOYMENT_GATE=
