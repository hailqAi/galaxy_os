  stockReturnId     String          @db.Uuid
  stockIssueLineId  String?         @db.Uuid
  inventoryItemId   String          @db.Uuid
  storageLocationId String?         @db.Uuid
  lotId             String?         @db.Uuid
  serialId          String?         @db.Uuid
  quantity          Decimal         @db.Decimal(20, 3)
