  statusHistory    StockAdjustmentStatusHistory[]

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId, projectId, warehouseId, status])
}

model StockAdjustmentLine {
  id                String          @id @default(uuid()) @db.Uuid
