  organizationId String        @db.Uuid
  name           String
  brandEcosystem String
  status         RecordStatus  @default(active)
  startDate      DateTime?
  endDate        DateTime?
  ownerId        String        @db.Uuid
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  owner          User          @relation("CampaignOwner", fields: [ownerId], references: [id])
  contentItems   ContentItem[]
  leads          Lead[]

  @@index([organizationId, status])
}

model ContentItem {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  title           String
  originalContent String
  campaignId      String?          @db.Uuid
  brandEcosystem  String
  status          ContentStatus    @default(DRAFT)
  authorId        String           @db.Uuid
  reviewerId      String?          @db.Uuid
  approverId      String?          @db.Uuid
  scheduledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id])
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  author          User             @relation("ContentAuthor", fields: [authorId], references: [id])
  reviewer        User?            @relation("ContentReviewer", fields: [reviewerId], references: [id])
  approver        User?            @relation("ContentApprover", fields: [approverId], references: [id])
  variants        ContentVariant[]
  publishingJobs  PublishingJob[]
  attributedLeads Lead[]

  @@index([organizationId, status, scheduledAt])
}

model ContentVariant {
  id             String          @id @default(uuid()) @db.Uuid
  contentItemId  String          @db.Uuid
  channel        String
  title          String?
  body           String
  media          Json?
  metadata       Json?
  status         String          @default("DRAFT")
  contentItem    ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  publishingJobs PublishingJob[]

  @@unique([contentItemId, channel])
}

model PublishingJob {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  contentItemId    String              @db.Uuid
  contentVariantId String              @db.Uuid
  channel          String
  scheduledAt      DateTime
  status           PublishingStatus    @default(SCHEDULED)
  attemptCount     Int                 @default(0)
  maxAttempts      Int                 @default(3)
  idempotencyKey   String              @unique
  publishedUrl     String?
  lastErrorCode    String?
  lastErrorMessage String?
  lockedAt         DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id])
  contentItem      ContentItem         @relation(fields: [contentItemId], references: [id])
  contentVariant   ContentVariant      @relation(fields: [contentVariantId], references: [id])
  attempts         PublishingAttempt[]

  @@index([organizationId, status, scheduledAt])
}

model PublishingAttempt {
  id                      String        @id @default(uuid()) @db.Uuid
  publishingJobId         String        @db.Uuid
  attemptNumber           Int
  startedAt               DateTime
  finishedAt              DateTime?
  status                  String
  providerResponseSummary Json?
  errorCode               String?
  errorMessage            String?
  publishingJob           PublishingJob @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)

  @@unique([publishingJobId, attemptNumber])
}
