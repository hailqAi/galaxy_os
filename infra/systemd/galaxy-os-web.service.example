[Unit]
Description=Galaxy OS web
After=galaxy-os-api.service
Wants=galaxy-os-api.service
PartOf=galaxy-os.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=<RUNTIME_ROOT>
EnvironmentFile=<PRIVATE_WEB_ENV_FILE>
Environment=GALAXY_LOCAL_RUNTIME_MANIFEST=<PRIVATE_MANIFEST_PATH>
ExecStart=/usr/bin/python3 <CONTROLLER_PATH> serve web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=galaxy-os.target
